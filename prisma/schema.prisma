generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Rarity {
 COMMON
 RARE
 EPIC
 LEGENDARY
}
model User {
 id String @id @default(cuid())
 discordId String @unique
 displayName String
 bio String @default("")
 coins BigInt @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 cards UserCard[]
}
model Player {
 id String @id @default(cuid())
 externalId String? @unique
 name String
 country String
 club String?
 position String
 cards Card[]
}
model Season {
 id String @id @default(cuid())
 name String @unique
 startsAt DateTime
 endsAt DateTime?
 cards Card[]
}
model Card {
 id String @id @default(cuid())
 slug String @unique
 playerId String
 player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)
 rarity Rarity @default(COMMON)
 rating Int
 edition String @default("base")
 seasonId String?
 season Season? @relation(fields: [seasonId], references: [id], onDelete: Restrict)
 imagePath String?
 createdAt DateTime @default(now())
 owners UserCard[]
 @@index([rarity, playerId])
}
model UserCard {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
 cardId String
 card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)
 acquiredAt DateTime @default(now())
 source String @default("grant")
 locked Boolean @default(false)
 @@index([userId, acquiredAt, id])
 @@index([cardId])
}

model GoalSubscription {
 id String @id @default(cuid())
 guildId String
 channelId String @unique
 league String
 teamId String
 teamName String
 enabled Boolean @default(true)
 revision String
 updatedAt DateTime @updatedAt
 snapshots GoalSnapshot[]
 notices GoalNotice[]
 narration MatchNarration?
}
model GoalSnapshot {
 id String @id @default(cuid())
 subscriptionId String
 subscription GoalSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
 eventId String
 revision String
 ownScore Int
 otherScore Int
 sequence Int @default(0)
 observedAt DateTime @default(now())
 @@unique([subscriptionId, eventId])
}
model GoalNotice {
 eventId String?
 id String @id @default(cuid())
 subscriptionId String
 subscription GoalSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
 revision String
 content String
 createdAt DateTime @default(now())
 sentAt DateTime?
 attempts Int @default(0)
 @@index([sentAt, createdAt])
}

model MatchNarration {
 id String @id @default(cuid())
 subscriptionId String @unique
 subscription GoalSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
 eventId String
 revision String
 messageId String?
 generation Int @default(0)
 rotate Boolean @default(false)
 sinceSequence Int @default(-1)
 payloadHash String @default("")
 updatedAt DateTime @updatedAt
}
